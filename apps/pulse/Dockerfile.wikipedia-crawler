FROM node:20-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
ENV PATH=/opt/venv/bin:$PATH

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./package.json
RUN npm install --include=dev --ignore-scripts --no-audit --no-fund

COPY workers/lead-intel-crawler/requirements.txt ./workers/lead-intel-crawler/requirements.txt
RUN python3 -m venv /opt/venv \
  && /opt/venv/bin/pip install --no-cache-dir -r workers/lead-intel-crawler/requirements.txt \
  && /opt/venv/bin/playwright install --with-deps chromium

COPY . .

CMD ["npm", "run", "wikipedia:crawl:continuous"]
