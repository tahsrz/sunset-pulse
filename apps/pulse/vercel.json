{
  "version": 2,
  "framework": "nextjs",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/billing/grace-expiry/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notifications/high-intent/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/atlas/processes/health",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/tenancy/domain-projection/cron",
      "schedule": "*/5 * * * *"
    }
  ]
}
